# Path: server/.env.example
# Purpose: Example relay configuration — copy to .env on the Protectli, chmod 600.

# The Protectli's Tailscale IP (100.x.y.z). The relay is published ONLY here.
TAILSCALE_IP=100.0.0.1

# Random secret that authorizes creating the vault and enrolling devices.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AETHERVAULT_ENROLL_SECRET=replace-with-a-random-secret
