# Created: 2026-09-16
# Last Edited: 2026-09-16 17:53 CT (America/Chicago)
# Path: tools/Dockerfile.sync
# Purpose: Container image for the AetherVault zero-knowledge sync server.

FROM python:3.12-slim

WORKDIR /app
COPY sync_server.py /app/sync_server.py

ENV AETHERVAULT_SYNC_DATA=/data
VOLUME ["/data"]
EXPOSE 8787

# Set AETHERVAULT_SYNC_TOKEN at runtime (docker -e / compose). Never bake it in.
CMD ["python", "/app/sync_server.py", "--host", "0.0.0.0", "--port", "8787", "--data", "/data"]
